{
  "title": "Distributed Job Queue - Overview",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Active Workers",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "djq_workers_active", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Jobs Processing",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "djq_jobs_processing", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Requests In Flight",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "djq_http_requests_in_flight", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Queue Depth (Estimated)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(djq_jobs_created_total) - sum(djq_jobs_completed_total) - sum(djq_jobs_failed_total) - sum(djq_jobs_cancelled_total)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(rate(djq_http_requests_total[1m])) by (status)", "legendFormat": "{{status}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Job Completion Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(djq_jobs_completed_total[1m]))", "legendFormat": "Completed", "refId": "A" },
        { "expr": "sum(rate(djq_jobs_failed_total[1m]))", "legendFormat": "Failed", "refId": "B" },
        { "expr": "sum(rate(djq_jobs_dlq_total[1m]))", "legendFormat": "DLQ", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "P95 HTTP Latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(djq_http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "A" }]
    }
  ]
}
