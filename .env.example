# .env.example
# Copy this file to .env to override defaults in docker-compose.yml
# NEVER commit the real .env file!

# Application Configuration
APP_MODE=all
INSTANCE_ID=local-node
PORT=8080
WORKER_COUNT=3

# Database Configuration
POSTGRES_USER=djq
POSTGRES_PASSWORD=djqpassword
POSTGRES_DB=djq_db

# Redis Configuration
# If running outside docker, use localhost. Inside docker, use the service name.
DATABASE_URL=postgres://djq:djqpassword@postgres:5432/djq_db?sslmode=disable
REDIS_URL=redis://redis:6379
